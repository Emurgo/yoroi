{
  "name": "yoroi-v2",
  "version": "6.2.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "patch-package",
    "eas-build-pre-install": "bash ./scripts/eas-pre-install.sh",
    "eas-build-post-install": "bash ./scripts/eas-post-install.sh",
    "start": "expo start -c",
    "start:nightly": "EXPO_PUBLIC_APP_CONFIG=app.config.nightly.js expo start -c",
    "start:production": "EXPO_PUBLIC_APP_CONFIG=app.config.production.js expo start -c",
    "android": "npx expo prebuild --platform android && expo run:android",
    "android:device": "npx expo prebuild --platform android && expo run:android --device",
    "android:reset": "rm -rf node_modules android && npm i && npx expo prebuild --platform android && expo run:android",
    "android:reset:device": "rm -rf node_modules android && npm i && npx expo prebuild --platform android && expo run:android --device",
    "android:nightly": "EXPO_PUBLIC_APP_CONFIG=app.config.nightly.js npx expo prebuild --platform android && EXPO_PUBLIC_APP_CONFIG=app.config.nightly.js expo run:android",
    "android:production": "EXPO_PUBLIC_APP_CONFIG=app.config.production.js npx expo prebuild --platform android && EXPO_PUBLIC_APP_CONFIG=app.config.production.js expo run:android",
    "android:standalone": "EXPO_PUBLIC_BUILD_VARIANT=DEV npx expo prebuild --platform android && cd android && SENTRY_DISABLE_AUTO_UPLOAD=true ./gradlew assembleRelease && cd ..",
    "android:standalone:apk": "EXPO_PUBLIC_BUILD_VARIANT=DEV npx expo prebuild --platform android && cd android && SENTRY_DISABLE_AUTO_UPLOAD=true ./gradlew assembleRelease && cd .. && echo 'APK location: android/app/build/outputs/apk/release/app-release.apk'",
    "ios": "npx expo prebuild --platform ios && expo run:ios",
    "ios:device": "npx expo prebuild --platform ios && expo run:ios --device",
    "ios:reset": "rm -rf node_modules ios && npm i && npx expo prebuild --platform ios && expo run:ios",
    "ios:reset:device": "rm -rf node_modules ios && npm i && npx expo prebuild --platform ios && expo run:ios --device",
    "ios:nightly": "EXPO_PUBLIC_APP_CONFIG=app.config.nightly.js npx expo prebuild --platform ios && EXPO_PUBLIC_APP_CONFIG=app.config.nightly.js expo run:ios",
    "ios:production": "EXPO_PUBLIC_APP_CONFIG=app.config.production.js npx expo prebuild --platform ios && EXPO_PUBLIC_APP_CONFIG=app.config.production.js expo run:ios",
    "dgraph": "dependency-cruiser src --include-only \"^src\" --output-type dot | dot -T svg > dependency-graph.svg",
    "intl:extract": "formatjs extract",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "web": "expo start --web",
    "tsc": "tsc --noEmit",
    "tsc:fix": "tsc --noEmit --fix",
    "test": "jest --config jest.config.js",
    "format": "prettier --write ."
  },
