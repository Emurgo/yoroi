{
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-native",
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
    "paths": {
      "~/ui/*": [
        "./src/ui/*"
      ],
      "~/features/*": [
        "./src/features/*"
      ],
      "~/common/*": [
        "./src/common/*"
      ],
      "~/hooks/*": [
        "./src/hooks/*"
      ],
      "~/kernel/*": [
        "./src/kernel/*"
      ],
      "~/wallets/*": [
        "./src/wallets/*"
      ],
      "~/queries": [
        "./src/queries"
      ],
      "~/utils/*": [
        "./src/utils/*"
      ],
      "~/components/*": [
        "./src/ui/*"
      ],
      "~/assets/*": [
        "./assets/*"
      ],
      "@yoroi/api": [
        "./packages/api"
      ],
      "@yoroi/blockchains": [
        "./packages/blockchains"
      ],
      "@yoroi/claim": [
        "./packages/claim"
      ],
      "@yoroi/common": [
        "./packages/common"
      ],
      "@yoroi/dapp-connector": [
        "./packages/dapp-connector"
      ],
      "@yoroi/exchange": [
        "./packages/exchange"
      ],
      "@yoroi/explorers": [
        "./packages/explorers"
      ],
      "@yoroi/identicon": [
        "./packages/identicon"
      ],
      "@yoroi/links": [
        "./packages/links"
      ],
      "@yoroi/notifications": [
        "./packages/notifications"
      ],
      "@yoroi/portfolio": [
        "./packages/portfolio"
      ],
      "@yoroi/resolver": [
        "./packages/resolver"
      ],
      "@yoroi/setup-wallet": [
        "./packages/setup-wallet"
      ],
      "@yoroi/staking": [
        "./packages/staking"
      ],
      "@yoroi/swap": [
        "./packages/swap"
      ],
      "@yoroi/theme": [
        "./packages/theme"
      ],
      "@yoroi/transfer": [
        "./packages/transfer"
      ],
      "@yoroi/types": [
        "./packages/types"
      ],
      "@yoroi/p2p-communication": [
        "./packages/p2p-communication"
      ],
      "@yoroi/tx": [
        "./packages/tx"
      ]
    }
  }
}