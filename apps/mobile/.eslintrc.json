{
  "extends": [
    "@react-native-community",
    "prettier"
  ],
  "plugins": [
    "prettier",
    "import"
  ],
  "rules": {
    "prettier/prettier": [
      "error",
      {
        "quoteProps": "consistent",
        "bracketSpacing": false,
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "all",
        "useTabs": false,
        "semi": false,
        "importOrder": [
          "^@yoroi/(.*)$",
          "^a-zA-Z@",
          "^./"
        ],
        "importOrderSeparation": true,
        "importOrderSortSpecifiers": true
      }
    ],
    "eqeqeq": "off"
  },
  "root": true
}